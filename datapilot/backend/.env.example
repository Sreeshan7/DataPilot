GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Phase 2: dataset discovery.
# Optional. Kaggle's public search endpoint works without a token; supplying one
# raises rate limits and unlocks private datasets. Never commit a real token.
KAGGLE_API_TOKEN=
KAGGLE_ENABLED=true

# Phase 3: richer verification. All optional; the defaults are shown.
# Hugging Face's public Hub search needs no credential.
HUGGINGFACE_ENABLED=true
# The top-K verified candidates are re-read from their registry (two requests
# each) before the final ranking. 0 or false disables the extra requests.
DATASET_ENRICHMENT_ENABLED=true
DATASET_ENRICHMENT_TOP_K=5
# At most this many AI suggestions are looked up by name in the registries.
DATASET_VERIFICATION_LOOKUPS=3

APP_ENV=development
LOG_LEVEL=INFO
